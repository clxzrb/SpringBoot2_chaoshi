<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzj.admin.mapper.PurchaseListGoodsMapper">
    <!-- 通用映射 -->
    <resultMap id="BaseResultMap" type="com.lzj.admin.pojo.PurchaseListGoods">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="model" property="model"/>
        <result column="name" property="name"/>
        <result column="num" property="num"/>
        <result column="price" property="price"/>
        <result column="total" property="total"/>
        <result column="unit" property="unit"/>
        <result column="purchase_list_id" property="purchaseListId"/>
        <result column="type_id" property="typeId"/>
        <result column="goods_id" property="goodsId"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,model,name,num,price,total,unit,purchase_list_id,type_id,goods_id
    </sql>

    <!-- 根据进货单ID查询明细，关联商品表 -->
    <select id="listPurchaseGoodsByPurchaseId" resultType="com.lzj.admin.pojo.PurchaseListGoods">
        SELECT plg.*,g.name AS goodsName,g.model AS goodsModel
        FROM t_purchase_list_goods plg
        LEFT JOIN t_goods g ON plg.goods_id = g.id
        WHERE plg.purchase_list_id = #{purchaseListId}
    </select>
</mapper>