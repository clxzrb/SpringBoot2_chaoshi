<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzj.admin.mapper.SupplierMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lzj.admin.pojo.Supplier">
        <id column="id" property="id" />
        <result column="address" property="address" />
        <result column="contact" property="contact" />
        <result column="name" property="name" />
        <result column="number" property="number" />
        <result column="remarks" property="remarks" />
        <result column="is_del" property="isDel" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, address, contact, name, "number", remarks, is_del
    </sql>

    <!-- 统计供应商总数 -->
    <select id="countSupplier" resultType="java.lang.Long">
        SELECT COUNT(1) FROM t_supplier
        WHERE is_del = 0
        <if test="null != supplierQuery.supplierName and supplierQuery.supplierName != ''">
            AND name LIKE CONCAT('%',#{supplierQuery.supplierName},'%')
        </if>
    </select>

    <!-- 分页查询供应商列表 -->
    <select id="supplierPageList" resultMap="BaseResultMap">
        SELECT id, address, contact, name, "number", remarks, is_del
        FROM t_supplier
        WHERE is_del = 0
        <if test="null != supplierQuery.supplierName and supplierQuery.supplierName != ''">
            AND name LIKE CONCAT('%',#{supplierQuery.supplierName},'%')
        </if>
        ORDER BY id DESC
    </select>

    <!-- 根据名称查询供应商 -->
    <select id="findSupplierByName" resultMap="BaseResultMap">
        SELECT id, address, contact, name, "number", remarks, is_del
        FROM t_supplier
        WHERE is_del = 0 AND name = #{name}
    </select>

</mapper>