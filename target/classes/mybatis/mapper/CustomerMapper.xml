<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzj.admin.mapper.CustomerMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lzj.admin.pojo.Customer">
        <id column="id" property="id" />
        <result column="address" property="address" />
        <result column="contact" property="contact" />
        <result column="name" property="name" />
        <result column="number" property="number" />
        <result column="remarks" property="remarks" />
        <result column="is_del" property="isDel" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        "id", "address", "contact", "name", "number", "remarks", "is_del"
    </sql>

	<!-- 手动统计总数 -->
	<select id="countCustomer" resultType="java.lang.Long">
	    SELECT COUNT(1) FROM t_customer
	    WHERE "is_del" = 0
	    <if test="null != customerQuery.customerName and customerQuery.customerName != ''">
	        AND "name" LIKE '%' || #{customerQuery.customerName} || '%'
	    </if>
	</select>
	
	<!-- 分页查询 -->
	<select id="customerPageList" resultType="com.lzj.admin.pojo.Customer">
	    SELECT "id","address","contact","name","number","remarks","is_del"
	    FROM t_customer
	    WHERE "is_del" = 0
	    <if test="null != customerQuery.customerName and customerQuery.customerName != ''">
	       AND "name" LIKE '%' || #{customerQuery.customerName} || '%'
	    </if>
	    ORDER BY "id" DESC
	</select>
	
	<!-- 根据名称查询客户 -->
    <select id="findCustomerByName" resultMap="BaseResultMap">
        SELECT "id", "address", "contact", "name", "number", "remarks", "is_del"
        FROM t_customer
        WHERE "is_del" = 0 AND "name" = #{name}
    </select>
    
    <!-- 查询所有未删除客户 -->
	<select id="findAllCustomers" resultMap="BaseResultMap">
	    SELECT "id", "address", "contact", "name", "number", "remarks", "is_del"
	    FROM t_customer
	    WHERE "is_del" = 0
	    ORDER BY "id" DESC
	</select>
</mapper>
